{
  "name": "todoapp",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "An ASP.NET Core app for managing Todo items",
  "scripts": {
    "build": "npm run compile && npm run format && npm run lint && npm test",
    "compile": "webpack",
    "format": "prettier --write scripts/**/*.ts",
    "lint": "eslint scripts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/martincostello/dotnet-minimal-api-integration-testing.git"
  },
  "author": "martincostello",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "moment": "2.31.0",
    "prettier": "3.9.8",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "auto",
    "printWidth": 80,
    "quoteProps": "consistent",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "useTabs": false
  }
}
